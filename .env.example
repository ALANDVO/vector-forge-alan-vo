# Vector Forge Environment Configuration
# Copy to .env and fill in values

# Application
APP_NAME=vector-forge
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
HOST=127.0.0.1
PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/vector_forge.db
DATABASE_ECHO=false

# MCP
MCP_TRANSPORT=http
MCP_HOST=127.0.0.1
MCP_PORT=8001

# Authentication (Keycloak OIDC)
# Get these from your Keycloak realm settings
OIDC_ISSUER_URL=http://localhost:8081/realms/vector-forge
OIDC_CLIENT_ID=vector-forge
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://127.0.0.1:8000/auth/callback
OIDC_SCOPES=openid profile email roles
OIDC_AUDIENCE=vector-forge-api

# Demo mode (localhost only, never enable in production)
DEMO_MODE=true
DEMO_USER_ID=demo-user
DEMO_USER_ROLES=viewer,operator

# LLM Providers (optional, for advisory explanations)
# LLM_PROVIDER=openai-compatible
# LLM_MODEL=gpt-4
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_TIMEOUT=30.0
# LLM_MAX_TOKENS=4096

# Analysis Limits
MAX_ANALYSIS_TIME_SECONDS=300
MAX_MEMORY_MB=1024
MAX_OUTPUT_SIZE_MB=50
MAX_CONCURRENT_ANALYSES=2

# Ghidra (bring your own installation)
GHIDRA_INSTALL_DIR=
GHIDRA_JAVA_HOME=
GHIDRA_MAX_HEAP_MB=512
GHIDRA_STARTUP_TIMEOUT_SECONDS=330

# Process Capture
PROCESS_CAPTURE_TIMEOUT_SECONDS=60
PROCESS_CAPTURE_MAX_OUTPUT_MB=10